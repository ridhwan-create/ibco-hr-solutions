+                        'probation_months' => $offer->probation_months,
+                        'expiry_date' => $offer->expiry_date?->toDateString(),
+                        'terms' => $offer->terms,
+                        'status' => $offer->status,
+                        'approval_notes' => $offer->approval_notes,
+                            'response_notes' => $offer->response_notes,
