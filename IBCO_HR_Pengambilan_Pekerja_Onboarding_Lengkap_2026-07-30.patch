+function CaseActions({ item }: { item: OnboardingCase }) {
+    const run = (action: string) => {
+        const notes = ['cancel', 'reopen'].includes(action)
+            ? window.prompt('Catatan:')
+            : null;
+
+        if (['cancel', 'reopen'].includes(action) && !notes) {
+            return;
+        }
+
+        router.patch(
+            `/onboarding/${item.id}/status`,
+            { action, notes },
+            { preserveScroll: true },
+        );
+    };
+
+    return (
+        <div className="flex flex-wrap gap-1">
+            {item.status === 'pending' && (
+                <Button size="sm" onClick={() => run('start')}>
+                    <Play />
+                    Mula
+                </Button>
+            )}
+            {item.status === 'active' && (
+                <Button size="sm" onClick={() => run('complete')}>
+                    <CheckCircle2 />
+                    Lengkapkan
+                </Button>
+            )}
+            {['pending', 'active'].includes(item.status) && (
+                <Button
+                    size="sm"
+                    variant="outline"
+                    onClick={() => run('cancel')}
+                >
+                    <XCircle />
+                    Batal
+                </Button>
+            )}
+            {item.status === 'cancelled' && (
+                <Button
+                    size="sm"
+                    variant="outline"
+                    onClick={() => run('reopen')}
+                >
+                    <RotateCcw />
+                    Buka Semula
+                </Button>
+            )}
+        </div>
+    );
