+        'clock_out_at' => '2026-07-14 18:00:00',
+        'source' => 'geolocation',
+        'status' => 'active',
+    ]);
+    $leaveType = LeaveType::query()->where('code', 'ANNUAL')->firstOrFail();
+    EmployeeLeaveRequest::query()->create([
+        'user_id' => $employeeUser->getKey(),
+        'employee_id' => $employeeId,
+        'department_id' => 1,
+        'leave_type_id' => $leaveType->getKey(),
