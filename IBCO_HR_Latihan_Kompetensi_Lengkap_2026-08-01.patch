+            'competencies' => Competency::query()->where('is_active', true)->orderBy('name')->get([
+                'id', 'code', 'name', 'category', 'maximum_level',
+            ]),
+            'competencyMatrix' => $this->competencyMatrix(),
+            'developmentPlans' => DevelopmentPlan::query()
