+
+function createPendingClaimAlert(
+    User $employee,
+    ClaimType $type,
+    int $departmentId,
+    string $stage,
+): ClaimRequest {
+    return ClaimRequest::query()->create([
+        'user_id' => $employee->getKey(),
+        'employee_id' => 3000 + $departmentId,
+        'department_id' => $departmentId,
+        'claim_type_id' => $type->getKey(),
+        'expense_date' => '2026-07-30',
