+                                                                    }
+                                                                    value={String(
+                                                                        type.id,
+                                                                    )}
+                                                                >
+                                                                    {type.name}
+                                                                </SelectItem>
+                                                            ),
+                                                        )}
+                                                    </SelectContent>
+                                                </Select>
+                                                <InputError
+                                                    message={
+                                                        form.errors
+                                                            .claim_type_id
+                                                    }
+                                                />
+                                            </div>
+                                            <div className="space-y-2">
+                                                <Label>
+                                                    Tarikh perbelanjaan
+                                                </Label>
+                                                <Input
+                                                    type="date"
+                                                    value={
+                                                        form.data.expense_date
+                                                    }
+                                                    onChange={(event) =>
+                                                        form.setData(
+                                                            'expense_date',
+                                                            event.target.value,
+                                                        )
