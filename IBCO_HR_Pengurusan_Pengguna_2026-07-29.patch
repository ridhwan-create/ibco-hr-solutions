diff --git a/resources/js/pages/users/partials/user-form.tsx b/resources/js/pages/users/partials/user-form.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5ce1685d1c726d8b32679658f63186efbf115a02
--- /dev/null
