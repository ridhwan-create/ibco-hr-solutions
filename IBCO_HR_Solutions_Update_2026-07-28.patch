diff --git a/README.md b/README.md
index c2b283c11d82ae5ca7744c4191f3c89d06f761ad..9f3ac228e141ff6c0b0a6811ebb134e81dc5b658 100644
--- a/README.md
+++ b/README.md
@@ -1 +1,40 @@
-"# ibco-hr-solutions" 
+# IBCO HR Solutions
+
+Sistem pengurusan sumber manusia berasaskan Laravel, React, Inertia.js dan
+database MySQL sedia ada `db_spp`.
+
+## Dashboard
+
+Dashboard memaparkan jumlah rekod aktif bagi setiap modul serta lima rekod
+kehadiran dan permohonan cuti terkini. Semua kad ringkasan boleh digunakan
+untuk membuka halaman index modul berkaitan.
+
+## Modul index
+
+- Pekerja
+- Jawatan
+- Kehadiran
+- Cuti
+- Kerja lebih masa
+- Payroll
+- Laporan bulanan
+
+Semua modul index menggunakan carian, pagination dan hanya memaparkan rekod
+aktif (`rcd_enable = 1`). Paparan ini tidak mengubah rekod dalam database asal.
+
+## Sambungan database
+
+Salin `.env.example` kepada `.env`, kemudian isi maklumat sambungan MySQL:
+
+```env
+DB_CONNECTION=mysql
+DB_HOST=127.0.0.1
+DB_PORT=3306
+DB_DATABASE=db_spp
+DB_USERNAME=root
+DB_PASSWORD=
+```
+
+Gunakan akaun database dengan akses minimum yang diperlukan. Tujuh paparan
+index di atas hanya membaca jadual HR lama; jadual rangka kerja Laravel seperti
+pengguna, sesi, cache dan queue mungkin masih memerlukan akses tulis.
diff --git a/app/Http/Controllers/DashboardController.php b/app/Http/Controllers/DashboardController.php
new file mode 100644
index 0000000000000000000000000000000000000000..888cef9961bf35a63fb6f88c8b97feaa9e51ed99
--- /dev/null
+++ b/app/Http/Controllers/DashboardController.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use Illuminate\Support\Facades\DB;
+use Inertia\Inertia;
+
+class DashboardController extends Controller
+{
+    public function index()
+    {
+        $statistics = [
+            'pekerja' => DB::table('maklumatpekerja')->where('rcd_enable', 1)->count(),
+            'jawatan' => DB::table('maklumatjawatan')->where('rcd_enable', 1)->count(),
+            'kehadiran' => DB::table('maklumatkehadiran')->where('rcd_enable', 1)->count(),
+            'cuti' => DB::table('maklumatcuti')->where('rcd_enable', 1)->count(),
+            'kerja_lebih_masa' => DB::table('maklumatot')->where('rcd_enable', 1)->count(),
+            'payroll' => DB::table('maklumatpayroll')->where('rcd_enable', 1)->count(),
+            'laporan_bulanan' => DB::table('reportbulanan')->where('rcd_enable', 1)->count(),
+        ];
+
+        $recentAttendance = DB::table('maklumatkehadiran as k')
+            ->leftJoin('maklumatpekerja as p', 'k.id_pekerja', '=', 'p.id')
+            ->where('k.rcd_enable', 1)
+            ->select([
+                'k.id',
+                'p.employeeID as employee_id',
+                'p.nama as nama_pekerja',
+                'k.waktu_masuk',
+                'k.waktu_keluar',
+                'k.catatan',
+            ])
+            ->orderByDesc('k.waktu_masuk')
+            ->orderByDesc('k.id')
+            ->limit(5)
+            ->get();
+
+        $recentLeave = DB::table('maklumatcuti as c')
+            ->leftJoin('maklumatpekerja as p', 'c.id_pekerja', '=', 'p.id')
+            ->leftJoin('xsenaraicuti as sc', 'c.jenis_cuti', '=', 'sc.id')
+            ->leftJoin('xstatuscuti as st', 'c.status_permohonan', '=', 'st.id')
+            ->where('c.rcd_enable', 1)
+            ->select([
+                'c.id',
+                'p.employeeID as employee_id',
+                'p.nama as nama_pekerja',
+                'sc.description as jenis_cuti',
+                'c.date_mulacuti as tarikh_mula',
+                'c.date_tamatcuti as tarikh_tamat',
+                'st.description as status_permohonan',
+            ])
+            ->orderByDesc('c.date_mulacuti')
+            ->orderByDesc('c.id')
+            ->limit(5)
+            ->get();
+
+        return Inertia::render('dashboard', [
+            'statistics' => $statistics,
+            'recentAttendance' => $recentAttendance,
+            'recentLeave' => $recentLeave,
+        ]);
+    }
+}
