+    private function auditEmployeeMap($audits): array
+    {
+        $employeeAuditIds = $audits
+            ->where('auditable_type', 'maklumatpekerja')
+            ->pluck('auditable_id')
+            ->filter(fn ($id) => is_numeric($id))
+            ->map(fn ($id) => (string) $id)
