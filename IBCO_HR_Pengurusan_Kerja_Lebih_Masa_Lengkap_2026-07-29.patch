+    ];
+    const submit = (event: FormEvent<HTMLFormElement>) => {
+        event.preventDefault();
+        post('/ot-saya', {
+            forceFormData: true,
+            preserveScroll: true,
+            onSuccess: () => reset(),
+        });
+    };
+
+    if (!employee) {
+        return (
+            <>
+                <Head title="OT Saya" />
+                <div className="mx-auto flex w-full max-w-4xl flex-1 p-4 md:p-6">
