+        } | null;
+        submitted_at: string;
+        supervisor_reviewer: string | null;
+        supervisor_review_notes: string | null;
+        reviewer: string | null;
+        review_notes: string | null;
+        has_attachment: boolean;
+        attachment_name: string | null;
+    }[];
+    legacyOvertime: {
