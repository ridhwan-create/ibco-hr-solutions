+                        />
+                        <InputError message={errors.notes} />
+                    </div>
+                    <label className="flex items-center gap-3 rounded-lg border p-3 text-sm">
+                        <input
+                            type="checkbox"
+                            checked={data.is_active}
+                            onChange={(event) =>
