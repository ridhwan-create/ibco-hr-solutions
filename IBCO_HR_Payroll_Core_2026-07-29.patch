+    approved_by: string | null;
+    finalized_by: string | null;
+};
+
+type Props = {
+    runs: {
+        data: PayrollRun[];
+        from: number | null;
+        to: number | null;
+        total: number;
+        links: { url: string | null; label: string; active: boolean }[];
+    };
+    filters: {
+        status: string;
