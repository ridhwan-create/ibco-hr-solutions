+    approved: 'Diluluskan',
+    finalized: 'Dimuktamadkan',
+};
+
+const statusStyles: Record<PayrollStatus, string> = {
+    draft: 'border-slate-500/30 bg-slate-500/10 text-slate-700 dark:text-slate-300',
