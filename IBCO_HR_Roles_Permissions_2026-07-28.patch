diff --git a/app/Enums/UserRole.php b/app/Enums/UserRole.php
new file mode 100644
index 0000000..99e20b9
--- /dev/null
+++ b/app/Enums/UserRole.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace App\Enums;
+
+enum UserRole: string
+{
+    case SuperAdmin = 'super_admin';
+    case HrAdmin = 'hr_admin';
+    case Viewer = 'viewer';
+
+    /**
+     * @return array<int, string>
+     */
+    public function permissions(): array
+    {
+        return match ($this) {
+            self::SuperAdmin => [
+                'dashboard.view',
+                'employees.view',
+                'positions.view',
+                'attendance.view',
+                'leave.view',
+                'overtime.view',
+                'payroll.view',
+                'reports.view',
+                'users.manage',
+            ],
+            self::HrAdmin => [
+                'dashboard.view',
+                'employees.view',
+                'positions.view',
+                'attendance.view',
+                'leave.view',
+                'overtime.view',
+                'payroll.view',
+                'reports.view',
+            ],
+            self::Viewer => [
+                'dashboard.view',
+                'employees.view',
+                'positions.view',
+                'attendance.view',
+                'leave.view',
+                'overtime.view',
+            ],
+        };
+    }
+
+    public function hasPermission(string $permission): bool
+    {
+        return in_array($permission, $this->permissions(), true);
+    }
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::SuperAdmin => 'Super Admin',
+            self::HrAdmin => 'HR Admin',
+            self::Viewer => 'Viewer / Manager',
+        };
+    }
+
+    public function description(): string
+    {
+        return match ($this) {
+            self::SuperAdmin => 'Akses penuh termasuk pengurusan pengguna dan role.',
+            self::HrAdmin => 'Akses semua modul HR termasuk payroll dan laporan.',
+            self::Viewer => 'Akses paparan operasi tanpa payroll, laporan dan pengurusan pengguna.',
+        };
+    }
+}
