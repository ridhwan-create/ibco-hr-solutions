+                                    {paginationLabel(link.label)}
+                                </button>
+                            ))}
+                        </div>
+                    )}
+                </div>
+            </div>
+        </>
+    );
+}
+
+UserManagement.layout = {
+    breadcrumbs: [
+        {
+            title: 'Roles & Permissions',
+            href: '/pengguna',
+        },
+    ],
+};
