+                    </Field>
+                    <div className="grid gap-3 sm:grid-cols-2">
+                        <CheckField
+                            label="Reset setiap tahun"
+                            checked={form.data.reset_annually}
+                            set={(checked) =>
+                                form.setData('reset_annually', checked)
