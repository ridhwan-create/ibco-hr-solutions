+        ])
+        ->assertRedirect()
+        ->assertSessionDoesntHaveErrors();
+    expect($case->fresh()->status)->toBe('decision');
+
+    $this->actingAs($users['decisionMaker'])
+        ->patch(route('discipline.decision', $case), [
+            'decision_outcome' => 'written_warning',
